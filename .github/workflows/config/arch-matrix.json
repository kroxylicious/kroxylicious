{
  "amd64": {
    "enabled": true,
    "default": true,
    "runs-on": "ubuntu-latest",
    "dist-profile": "dist,!qa",
    "qemu": false,
    "native-check": "x86_64"
  },
  "arm64": {
    "enabled": true,
    "default": false,
    "runs-on": "ubuntu-24.04-arm",
    "dist-profile": "dist,aarch64,!qa",
    "qemu": false,
    "native-check": "aarch_64"
  },
  "ppc64le": {
    "enabled": false,
    "default": false,
    "runs-on": "ubuntu-24.04-ppc64le",
    "dist-profile": "dist,ppc64le,!qa",
    "qemu": false,
    "native-check": "none"
  },
  "s390x": {
    "enabled": false,
    "default": false,
    "runs-on": "ubuntu-24.04-s390x",
    "dist-profile": "dist,s390x,!qa",
    "qemu": false,
    "native-check": "none"
  }
}
